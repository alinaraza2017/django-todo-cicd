pipeline {
    agent any

    stages {
        stage('Code Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/alinaraza2017/django-todo-cicd.git'
                sh '''
                    echo "Repository Name : $(basename -s .git $(git config --get remote.origin.url))"
                    echo "Remote URL      : $(git config --get remote.origin.url)"
                    echo "Current Branch  : $(git rev-parse --abbrev-ref HEAD)"
                    echo "----- Workspace contents -----"
                    ls -la
                '''
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t todo .'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

                stage('Deploy') {
            steps {
                sh '''
                    # port 8000/8001 par jo bhi container ho, hata do
                    docker ps -aq --filter "publish=8000" | xargs -r docker rm -f
                    docker ps -aq --filter "publish=8001" | xargs -r docker rm -f
                    docker rm -f todo_container1 todo_container2 || true

                    # do containers same image se
                    docker run -d --name todo_container1 -p 8000:8000 todo
                    docker run -d --name todo_container2 -p 8001:8000 todo

                    # verify
                    echo "----- Running containers -----"
                    docker ps --filter "name=todo_container"

                    # browser mein check karne ka waqt
                    sleep 60

                    # stop aur remove
                    docker stop todo_container1 todo_container2
                    docker rm todo_container1 todo_container2
                    echo "Both containers stopped and removed"
                '''
            }
        }

    post {
        success {
            echo 'Pipeline executed successfully'
        }
        failure {
            echo 'Pipeline execution failed'
        }
        always {
            echo 'Pipeline execution completed'
        }
    }
}
