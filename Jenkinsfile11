pipeline {
    agent any

    stages {
        stage('Code Checkout') {
            steps {
                git branch: 'develop', url: 'https://github.com/alinaraza2017/django-todo-cicd.git'
                sh '''
                    echo "Repository Name : $(basename -s .git $(git config --get remote.origin.url))"
                    echo "Remote URL      : $(git config --get remote.origin.url)"
                    echo "Current Branch  : $(git rev-parse --abbrev-ref HEAD)"
                    echo "----- Workspace contents -----"
                    ls -la
                '''
            }
        }

        stage('Build') {
            steps {
                sh 'docker buildd -t todo .'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker rm -f todo_container || true'
                sh 'docker run -d --name todo_container -p 8000:8000 todo'
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully'
        }
        failure {
            echo 'Pipeline execution failed'
        }
        always {
            echo 'Pipeline execution completed'
        }
    }
}
